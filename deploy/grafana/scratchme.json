   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "topk(5, histogram_quantile(0.95, sum by (le, route) (rate(scratchme_http_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval]))))",
