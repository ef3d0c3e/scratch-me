{
 "title": "Scratch-me",
 "uid": "scratchme",
 "tags": [
  "scratchme"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "timezone": "browser",
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0
   },
   {
    "name": "job",
    "label": "Job",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(scratchme_players, job)",
     "refId": "job"
    },
    "definition": "label_values(scratchme_players, job)",
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "current": {},
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Online players",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(scratchme_online_users{job=~\"$job\"})",
     "legendFormat": "Online players"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Members",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
