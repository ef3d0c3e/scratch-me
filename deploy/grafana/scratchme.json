      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(scratchme_players{job=~\"$job\", kind=\"member\"})",
     "legendFormat": "Members"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
