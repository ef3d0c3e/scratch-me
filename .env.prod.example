# Copy to .env.prod (chmod 600) and fill in. Used by compose.prod.yaml.
# Public host name, as nginx serves it
DOMAIN=scratch.example.org
# A long random string: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
RUST_LOG=info
# Where nginx reaches the API and the site, on the host's loopback.
# AnyCardz has 8080 and 3000; change the nginx upstreams if you change these.
API_PORT=8081
WEB_PORT=3001
# Prometheus scraping: where /metrics is published on the host (AnyCardz has 9100),
# and the bearer token it must send. Publishing beyond 127.0.0.1 needs a token.
METRICS_PUBLISH=127.0.0.1:9101
METRICS_TOKEN=
# The Docker network, and nginx's address on it (its gateway): the one proxy believed
#SUBNET=172.31.0.0/24
#TRUSTED_PROXIES=172.31.0.1
