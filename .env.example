# Postgres from compose.yaml (host port 5434)
DATABASE_URL=postgres://scratchme:scratchme@127.0.0.1:5434/scratchme
# Where the API listens
SCRATCHME_BIND=127.0.0.1:8081
# Set to 1 when served over HTTPS so the session cookie is Secure
SCRATCHME_SECURE_COOKIES=0
# Proxies whose X-Forwarded-For gives the client address (comma separated IPs)
SCRATCHME_TRUSTED_PROXIES=
# 1 lifts the login and sign-up rate limits: development and tests only
SCRATCHME_RELAXED_LIMITS=1
RUST_LOG=info,scratchme_api=debug
# Integration tests (cargo test) use their own database
TEST_DATABASE_URL=postgres://scratchme:scratchme@127.0.0.1:5434/scratchme_test
# Prometheus scrapes /metrics here; no metrics listener when unset (9100 is AnyCardz's)
#SCRATCHME_METRICS_BIND=127.0.0.1:9101
# When set, scrapes must send Authorization: Bearer <token>
#SCRATCHME_METRICS_TOKEN=
